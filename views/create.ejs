<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <!-- Page title sent from the route -->
  <h1><%= title %></h1>

  <!-- Study Session Creation Form -->
  <!-- Sends the entered information to the /create route using POST -->
   <form action="/create" method="POST" class="session-form">

  <!-- Course name or course code -->
  <label for="course">Course:</label>
  <input type="text" id="course" name="course"
         placeholder="e.g. INFR3120U" required>

  <!-- Topic that students will study during the session -->
  <label for="topic">Study Topic:</label>
  <input type="text" id="topic" name="topic"
         placeholder="e.g. Express.js Review" required>

  <!-- Date when the study session will take place -->
  <label for="date">Date:</label>
  <input type="date" id="date" name="date" required>

  <!-- Time when the study session will begin -->
  <label for="time">Time:</label>
  <input type="time" id="time" name="time" required>

  <!-- Location where students will meet -->
  <label for="location">Location:</label>
  <input type="text" id="location" name="location"
         placeholder="e.g. Library Room 201" required>

  <!-- Name of the student organizing the session -->
  <label for="organizer">Organizer:</label>
  <input type="text" id="organizer" name="organizer"
         placeholder="Your name" required>

  <!-- Submits the completed form to the server -->
  <button type="submit" class="home-button">
    Create Study Session
  </button>

</form>



  <!-- Return to the home page -->
  <a href="/" class="home-button">Back to Home</a>
  <a href="/groups" class="home-button">View Study Groups</a>
</body>
</html>