<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
<body class="home-page">

  <!-- team logo -->
  <img src="/images/logo.png"
       alt="StudyCircle team logo"
       width="180">

  <!-- Welcome message and website introduction -->
  <main class="home-welcome">
    <h1>Welcome to <%= title %>!</h1>

    <p>
      Finding people to study with should be easy. StudyCircle helps
      you connect with other students, review course material,
      and prepare for exams together.
    </p>

    <p>
      Have a study session in mind? Create one and share the course,
      topic, time, and location. Looking for study partners?
      Browse the available sessions and contact an organizer
      to find out more.
    </p>

    <!-- Links to create and browse study sessions -->
    <a href="/create" class="home-button">Create a Study Session</a>
    <a href="/groups" class="home-button">View Study Groups</a>
  </main>

</body>
</html>
