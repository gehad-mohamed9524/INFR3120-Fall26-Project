<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <!-- Page title sent from the route -->
  <h1><%= title %></h1>

<!-- Display a message if there are no sessions -->
<% if (sessions.length === 0) { %>
  <p>No study sessions available yet.</p>
<% } else { %>

  <table class="session-table">
    <tr>
      <th>Course</th>
      <th>Topic</th>
      <th>Date</th>
      <th>Time</th>
      <th>Location</th>
      <th>Organizer</th>
    </tr>

    <!-- Repeat a row for each saved session -->
    <% for (var i = 0; i < sessions.length; i++) { %>
      <tr>
        <td><%= sessions[i].course %></td>
        <td><%= sessions[i].topic %></td>
        <td><%= sessions[i].date %></td>
        <td><%= sessions[i].time %></td>
        <td><%= sessions[i].location %></td>
        <td><%= sessions[i].organizer %></td>
      </tr>
    <% } %>
  </table>

<% } %>

  <!-- Return to the home page -->
  <a href="/" class="home-button">Back to Home</a>
  <a href="/create" class="home-button">Create a Study Session</a>
</body>
</html>